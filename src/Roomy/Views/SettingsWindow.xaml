<Window x:Class="Roomy.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Roomy.Core"
        Title="{loc:Tr SettingsTitle}" Width="610" Height="740" MinWidth="540" MinHeight="560"
        Icon="/Roomy;component/Assets/roomy.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Window.Resources>
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,6,22,6" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                                    BorderBrush="#45454D" BorderThickness="1.5" Background="{StaticResource Surface2Brush}">
                                <TextBlock x:Name="Mark" Text="" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="#111113" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="0" />
                                <Setter TargetName="Mark" Property="Text" Value="&#xE73E;" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="32,6,0,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{loc:Tr SettingsHeader}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr SettingsHeaderHint}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Options" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="BackgroundCheck" Content="{loc:Tr SetTray}" Style="{StaticResource SettingCheck}" Click="Background_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr SetTrayHint}" />
                        <CheckBox x:Name="StartupCheck" Content="{loc:Tr SetStartup}" Style="{StaticResource SettingCheck}" Margin="0,20,0,0" Click="EnableBackground_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr SetStartupHint}" />
                        <TextBlock x:Name="StartupMessage" Style="{StaticResource Hint}" Foreground="{StaticResource WarnBrush}" />
                        <Button Content="{loc:Tr SetStartupButton}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7"
                                HorizontalAlignment="Left" Margin="32,10,0,0" Click="StartupSettings_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="LowSpaceCheck" Content="{loc:Tr SetLowSpace}" Style="{StaticResource SettingCheck}" Click="EnableBackground_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr SetLowSpaceHint}" />
                        <WrapPanel Margin="32,14,0,0">
                            <TextBlock Text="{loc:Tr SetBelow}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="ThresholdBox" Width="58" Padding="6" Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" AutomationProperties.Name="{loc:Tr SetThresholdName}" />
                            <TextBlock Text="{loc:Tr SetGbEvery}" VerticalAlignment="Center" Margin="8,0" />
                            <ComboBox x:Name="IntervalBox" Width="118" Style="{StaticResource SettingCombo}" SelectedValuePath="Tag" AutomationProperties.Name="{loc:Tr SetIntervalName}">
                                <ComboBoxItem Content="{loc:Tr Set30}" Tag="30" />
                                <ComboBoxItem Content="{loc:Tr Set60}" Tag="60" />
                            </ComboBox>
                        </WrapPanel>
                        <CheckBox x:Name="WeeklyCheck" Content="{loc:Tr SetWeekly}" Style="{StaticResource SettingCheck}" Margin="0,22,0,0" Click="EnableBackground_Click" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:Tr SetWeeklyHint}" />
                        <TextBlock x:Name="PauseStatus" Style="{StaticResource Hint}" Margin="32,18,0,0" />
                        <WrapPanel Margin="32,10,0,0">
                            <Button Content="{loc:Tr SetPause}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7" Margin="0,0,8,8" Click="Pause_Click" />
                            <Button Content="{loc:Tr SetResume}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7" Margin="0,0,0,8" Click="Resume_Click" />
                        </WrapPanel>
                        <Button Content="{loc:Tr SetNotifButton}" Style="{StaticResource SecondaryButton}" FontSize="12" Padding="12,7"
                                HorizontalAlignment="Left" Margin="32,2,0,0" Click="NotificationSettings_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" FontSize="12.5" Margin="0,0,0,12" />
            <Grid>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" AutomationProperties.Name="{loc:Tr SetVersionName}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Tr Cancel}" IsCancel="True" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="{loc:Tr SetSave}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
